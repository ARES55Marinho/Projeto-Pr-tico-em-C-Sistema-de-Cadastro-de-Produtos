void buscarPreco() {
    float precoMin; 
    float precoMax; 
    char  linha[200];
    int encontrou = 0;
    FILE *f = fopen(ARQUIVO, "r");

    if(f == NULL) {
        printf("Arquivo não encontrado.\n");
        return;
    }

    printf("Digite o preco minimo ");
    scanf(" %f",& precoMin);
    
    printf("Digite o preco maximo ");
    scanf(" %f",& precoMax);

    while(fgets(linha, sizeof(linha), f)) {
        Produto p;
        sscanf(linha, "%99[^;];%49[^;];%f", p.nome, p.categoria, &p.preco);
        if (p.preco >= precoMin && p.preco <= precoMax){
            printf("\nProduto encontrado!nNome: %s\nCategoria: %s\nPreço: R$ %.2f\n", p.nome, p.categoria, p.preco);
            encontrou = 1;
        }
    }
    if(!encontrou) printf("Produto não encontrado.\n");
    fclose(f);
}


void removerProduto() {
    FILE *f = fopen(ARQUIVO, "r");
    FILE *sdel = fopen("nome.txt", "w");
     
    char linha[250];
    char Procura[TAM];
    Produto p;
    int encontrou = 0;
	
	if (f == NULL) {
		printf("Arquivo não encontrado\n");
		return;
	}
	if (sdel == NULL){
		printf("Não foi possivel criar");
		fclose(f);
		return;
	} 
	printf("Qual produto deseja remover:\n");
    scanf(" %99[^\n]", Procura);
    
    while (fgets(linha, 250, f) != NULL) {

        char copia[250];
        strcpy(copia, linha);

        strcpy(p.nome, strtok(copia, ";"));
        strcpy(p.categoria, strtok(NULL, ";"));
        p.preco = atof(strtok(NULL, ";\n"));

        if (strcmp(p.nome, Procura) == 0) {
            encontrou = 1;
        }
        else {
            fprintf(sdel, "%s", linha);
        }
    }
    fclose(f);
    fclose(sdel);

    remove(ARQUIVO);
    rename("nome.txt", ARQUIVO);

    if (encontrou == 1) {
        printf("Produto removido com sucesso!\n");
    }
    else {
        printf("Produto nao encontrado.\n");
    }
}
